            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "notes": "⚙️ Edit these values for your installation.",
      "notesInFlow": true
    },
    {
      "id": "4a4c044d-2b30-5f2e-a87e-b03071749d75",
      "name": "Map Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        560
      ],
      "parameters": {
        "jsCode": "// Accepts flat payloads such as { name, email, phone, company, message, services, budget, timeline }.\nconst src = $('External Lead Webhook').first().json.body || {};\nconst pick = (...keys) => { for (const k of keys) { if (src[k] !== undefined && src[k] !== null && src[k] !== \"\") return src[k]; } return undefined; };\nconst services = [].concat(pick(\"services\", \"service\") || [\"web-design\"]).map(String);\nconst payload = {\n  project: {\n    services,\n    description: String(pick(\"message\", \"description\", \"brief\", \"details\") || \"Imported lead — details to be confirmed on the discovery call.\").padEnd(30, \".\"),\n    name: pick(\"project\", \"projectName\"),\n  },\n  plan: { budget: pick(\"budget\") || \"not-sure\", timeline: pick(\"timeline\") || \"flexible\" },\n  contact: {\n    name: String(pick(\"name\", \"full_name\", \"fullName\") || \"Unknown\"),\n    email: String(pick(\"email\", \"email_address\")),\n    phone: pick(\"phone\", \"phone_number\"),\n    company: pick(\"company\", \"company_name\"),\n    consent: true,\n  },\n  meta: { source: \"import\", utm: { source: pick(\"utm_source\", \"source\") } },\n};\nreturn [{ json: { payload } }];"
      }
    },
    {
      "id": "f2f63eeb-4a1f-56ef-ac0b-25bf503e0279",
      "name": "Create Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        560
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (import)').first().json.appBaseUrl }}/api/v1/onboard",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "45c2e32a41e157",
          "name": "ASD · App API (n8n → app)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
