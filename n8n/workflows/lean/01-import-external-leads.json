      "typeVersion": 1,
      "position": [
        -480,
        460
      ],
      "parameters": {
        "content": "## Import leads from anywhere\nPoint Typeform, Webflow forms, Meta Lead Ads (or any tool) at this webhook: `POST /webhook/asd-external-lead`.\n\n**Map Fields** converts the payload into the app's lead schema and **Create Lead** calls `POST /api/v1/onboard` with the App API token — the lead then flows through the normal pipeline (alerts, AI analysis, CRM).\n\nAdjust the mapping to your form's field names.",
        "width": 420,
        "height": 300,
        "color": 4
      }
    },
    {
      "id": "589f9f9f-ca20-5bdc-a5d7-4d598d0be6df",
      "name": "External Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        560
      ],
      "webhookId": "8297c547-9b22-585b-a1b5-5c7778256888",
      "parameters": {
        "httpMethod": "POST",
        "path": "asd-external-lead",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "fd744667be1350",
          "name": "ASD · Webhook auth (app → n8n)"
        }
      }
    },
    {
