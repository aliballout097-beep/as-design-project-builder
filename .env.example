# =============================================================================
# AS Design Studio — Automation Suite · environment variables
# Copy to .env.local (development) or set in your host (Vercel / Docker).
# Every integration is optional: with nothing set, the app runs locally with a
# JSON file store, the rule-based estimator and a development admin login.
# =============================================================================

# --- Public URLs -------------------------------------------------------------
# Where this platform is served (used in emails, PDFs, share links, n8n payloads)
NEXT_PUBLIC_APP_URL=https://automation.asdesignlb.com
# The studio's main site (header link, "back to site" buttons)
NEXT_PUBLIC_SITE_URL=https://asdesignlb.com
# "See our work" buttons (header, hero, proposal page, email, PDF). Defaults to https://asdesignlb.com/portfolio
# NEXT_PUBLIC_PORTFOLIO_URL=https://asdesignlb.com/portfolio
NEXT_PUBLIC_CONTACT_EMAIL=info@asdesignlb.com
# Optional: Calendly / Cal.com link offered after submission and acceptance
NEXT_PUBLIC_BOOKING_URL=
# Shown as the AI persona's principal / PDF signature (defaults to "Ali Mawla")
NEXT_PUBLIC_OWNER_NAME=Ali Mawla
# International format, digits only (no "+", spaces or dashes), e.g. 9613123456
# Powers the 1-click WhatsApp kickoff button; leave empty to hide it.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional footer / PDF line, e.g. "Beirut · Worldwide"
NEXT_PUBLIC_STUDIO_LOCATION=
NEXT_PUBLIC_CURRENCY=USD

# --- Admin access ------------------------------------------------------------
# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
# Generate with:  npm run admin:hash -- "your long password"
ADMIN_PASSWORD_HASH=
# Optional extra admins: comma-separated email:hash pairs
ADMIN_USERS=

# --- Data store --------------------------------------------------------------
# supabase | local   (auto: supabase when both keys below are set)
DATA_STORE=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only! Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# JSON file store location when DATA_STORE=local
LOCAL_DATA_DIR=.data

# --- AI scope & budget analysis ---------------------------------------------
# anthropic | openai | heuristic   (auto: anthropic when ANTHROPIC_API_KEY is set)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AI_EFFORT=high
# Also powers voice-note transcription (Whisper) at POST /api/v1/transcribe,
# regardless of AI_PROVIDER — set it even if Claude is your analysis provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Fall back to the rule-based estimator if the AI call fails (recommended)
AI_FALLBACK_TO_HEURISTIC=true
# n8n | app  — who runs the AI analysis (auto: n8n when lead-intake + analysis webhooks are set)
ANALYSIS_RUNNER=

# --- Email (the app sends every email itself — recommended) -------------------
# Hostinger mailbox that SENDS proposals and RECEIVES lead alerts. Sending as the
# mailbox itself is what makes SPF + DKIM + DMARC pass → inbox, not spam.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@asdesignlb.com
# The mailbox password (hPanel → Emails → info@asdesignlb.com). Server-only secret.
SMTP_PASS=
# Optional: defaults to SMTP_USER. Must be on the same domain.
MAIL_FROM=info@asdesignlb.com
MAIL_FROM_NAME=Ali Mawla · AS Design
# New-lead / proposal-sent / accepted alerts (comma separated)
ADMIN_NOTIFY_EMAILS=info@asdesignlb.com
# app (default when SMTP is set) | n8n | off
EMAIL_DELIVERY=app
# If n8n hasn't returned the AI analysis after this many minutes, the app runs it itself
ANALYSIS_FALLBACK_MINUTES=8

# --- WhatsApp to clients (Meta WhatsApp Cloud API — official) ------------------
# Clients who add a WhatsApp number get the proposal PDF on WhatsApp too.
# Needs an approved "proposal_ready" template — see README → WhatsApp to clients.
# Permanent System User token with whatsapp_business_messaging permission:
WHATSAPP_TOKEN=
# The numeric "Phone number ID" from WhatsApp Manager → API Setup (not the phone number):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=proposal_ready
WHATSAPP_TEMPLATE_LANG=ar
WHATSAPP_API_VERSION=v23.0
# Added to local numbers typed without a country code (03 123 456 → 9613123456)
WHATSAPP_DEFAULT_COUNTRY_CODE=961

# --- n8n ---------------------------------------------------------------------
# Base of your n8n production webhook URLs; the app appends:
#   /asd-lead-intake  /asd-ai-analysis  /asd-proposal-dispatch  /asd-crm-sync
N8N_WEBHOOK_BASE_URL=https://n8n.asdesignlb.com/webhook
# app → n8n: sent as "Authorization: Bearer <secret>" (+ HMAC X-ASD-Signature)
N8N_WEBHOOK_SECRET=
# n8n → app: n8n sends "Authorization: Bearer <secret>" to /api/v1/*
N8N_CALLBACK_SECRET=
# Optional per-workflow overrides: a full URL, or "off" to stop sending that workflow's events.
# Recommended split (the app emails/WhatsApps, n8n only analyses — see n8n/workflows/lean/):
#   ANALYSIS_RUNNER=n8n  N8N_WEBHOOK_LEAD_INTAKE=off  N8N_WEBHOOK_DISPATCH=off  N8N_CRM_SYNC_ENABLED=false
N8N_WEBHOOK_LEAD_INTAKE=
N8N_WEBHOOK_ANALYSIS=
N8N_WEBHOOK_DISPATCH=
N8N_WEBHOOK_CRM_SYNC=
N8N_CRM_SYNC_ENABLED=true

# --- Security & embedding ------------------------------------------------------
# Sites allowed to iframe /embed (CSP frame-ancestors), space or comma separated
EMBED_ALLOWED_ORIGINS=https://asdesignlb.com https://www.asdesignlb.com
# Origins allowed to POST /api/v1/onboard directly from the browser (custom forms)
ALLOWED_ORIGINS=https://asdesignlb.com,https://www.asdesignlb.com
# Shared rate limiting across instances (recommended on serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for hashed client IPs (defaults to SESSION_SECRET)
IP_HASH_SALT=
# Minimum seconds a human needs to complete the builder (spam heuristic)
ONBOARD_MIN_FILL_SECONDS=4
